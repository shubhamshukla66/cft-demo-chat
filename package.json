{
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "firebase-admin": "13.10.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
